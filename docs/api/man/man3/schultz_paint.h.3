.SS "int32_t schultz_draw_fill_path (\fBschultz_draw_list\fP * list, const uint8_t * steps, uint32_t step_count, const \fBschultz_point\fP * points, uint32_t point_count, \fBschultz_paint\fP paint, uint32_t rule)"

.PP
